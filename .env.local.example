# ============================================================================
# AI 智盈 · 生产环境配置模板（.env.local.example）
# ----------------------------------------------------------------------------
# 用法：复制为服务器上的 .env.local 后，把占位符换成真实值：
#   cp .env.local.example C:\aizhiying\.env.local
#
# ⚠ 合规提示（必读 server/README.md 第 283–290 行）：
#   crawler 自建爬虫通道抓取第三方平台公开评论区，与前端「条款与隐私」页的
#   表述冲突，且涉及个人信息保护与不正当竞争风险。若启用 COLLECT_CRAWLER_URL，
#   请把爬虫严格限定为「自有账号内容 / 已获书面授权的内容源」，并同步更新条款。
#   不打算用 crawler 时，注释掉 COLLECT_CRAWLER_URL，只用 official + vendor。
# ============================================================================

# ---- 运行模式 ----
NODE_ENV=production          # 生产务必 production；演示才用 development
DEMO_MODE=0                  # 0 = 关演示（生产必须）
HOST=0.0.0.0                 # 对外监听；若挂 Nginx/TLS 可改 127.0.0.1
PORT=8787
DATA_DIR=.data               # 生产数据根（建议独立磁盘/备份）
STATIC_ROOT=                 # 留空=用项目根静态；如另挂 CDN 填其基址

# ---- 鉴权 ----
API_TOKEN=<换成 40 位十六进制令牌>   # 务必非空；公网切勿留空

# ---- 渲染（FFmpeg）----
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
RENDER_CONCURRENCY=2

# ---- 采集通道（生产：ALLOW_LOCAL_* 必须留空/删除）----
ALLOW_LOCAL_COLLECT=         # 留空 = 关闭本地模拟（生产必须）
ALLOW_LOCAL_GEO=             # 留空 = 关闭本地模拟（生产必须）
COLLECT_TICK_MS=30000
COLLECT_DEFAULT_CHANNEL=auto  # auto | official | crawler | vendor

# 自建爬虫通道（验证阶段可指向 tools/crawler-verify 的 8801；生产请换成合规爬虫）
# 同一台 Windows Server 上跑验证桩：http://127.0.0.1:8801
COLLECT_CRAWLER_URL=http://127.0.0.1:8801
# COLLECT_CRAWLER_TOKEN=      # 非可信网络才需要；验证桩可留空

# 以下两条为「合规推荐」通道（按需启用其一或两者）：
# COLLECT_OFFICIAL_URL=        # 自有内容评论区（平台官方开放能力，scope=own）
# COLLECT_OFFICIAL_OWNER=       # 自有账号标识（缺此项采集会「成功但空」，最易漏）
# COLLECT_UPSTREAM=             # 第三方数据服务（契约冻结，无 scope）
# COLLECT_TOKEN=                # 供应商 Bearer 令牌

# ---- GEO 监测（生产需接真实上游，否则保持未配置、不要开本地模拟）----
# GEO_UPSTREAM=
# GEO_TOKEN=

# ---- 支付 / 云部署（按需）----
# PAY_GATEWAY=
# PAY_MCH_ID=
# TCB_SECRET_ID=
# TCB_SECRET_KEY=
# TCB_BUCKET=
# TCB_REGION=
# TCB_ENV_ID=

# ---- 关闭 QA 后门 ----
QA_MODE=0
