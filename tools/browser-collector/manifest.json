{
  "manifest_version": 3,
  "name": "AI智盈 · 浏览器采集器",
  "version": "1.3.8",
  "description": "用你自己的登录态读取公开搜索结果与评论区；数据只回传给你自己的系统，不上传任何账号信息。",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8801/*",
    "https://www.douyin.com/*",
    "https://www.xiaohongshu.com/*",
    "https://www.kuaishou.com/*",
    "https://v.kuaishou.com/*",
    "https://channels.weixin.qq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "浏览器采集器"
  },
  "icons": {}
}
