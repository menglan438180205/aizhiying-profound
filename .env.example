# =========================================================
# AI智盈 · 服务端层（BFF）环境变量样例
# ---------------------------------------------------------
# 用法：
#   cp .env.example .env      然后逐项填写
#   docker compose up -d --build
#
# 铁律：
#   · NODE_ENV=production 时，本文件的危险开关（QA_MODE /
#     ALLOW_LOCAL_COLLECT / ALLOW_LOCAL_GEO）一旦非空，
#     进程会以退出码 78 拒绝启动。这是刻意设计。
#   · 只读一半就上线 = 假数据对外。配置完请跑：
#       node server/preflight.js --strict
# =========================================================

# ---------------------------------------------------------
# 一、运行基座
# ---------------------------------------------------------
NODE_ENV=production
# 演示模式：1=启用演示数据（/v1/demo/dataset + 独立演示库 .data/demo/）
#           留空/0=生产模式。NODE_ENV=production 时即使设 1 也会被强制关闭
DEMO_MODE=
# 容器内固定 0.0.0.0；由 Docker 网络隔离，端口不映射到宿主机
HOST=0.0.0.0
PORT=8787
# 必须显式指定并挂载持久卷，否则容器重建即丢失订单与任务记录
DATA_DIR=/data
# 前端 SPA 所在目录（镜像内为 /app）
STATIC_ROOT=/app
# 前置 Nginx 终止 TLS，声明后服务端才信任 X-Forwarded-* 头
TRUST_PROXY=1
# 1 = 静默运行日志（只留错误）
QUIET=

# ---------------------------------------------------------
# 二、鉴权（必填）
# ---------------------------------------------------------
# 生成：openssl rand -hex 24
# 不设置 → 生产守卫直接拒绝启动
API_TOKEN=

# ---------------------------------------------------------
# 三、风险豁免（强烈不建议开启）
# ---------------------------------------------------------
# 1 = 即使存在阻断级配置问题也继续启动；仍会强制关闭 QA_MODE 后门
ALLOW_INSECURE_BOOT=

# ---------------------------------------------------------
# 四、渲染 Worker（FFmpeg）
# ---------------------------------------------------------
# 留空则自动探测 PATH / 常见安装目录
FFMPEG_PATH=
FFPROBE_PATH=
# 同时渲染的任务数；按 CPU 核数给（每任务约 1-2 核）
RENDER_CONCURRENCY=2
# 单任务的成片数量上限，防滥用
RENDER_MAX_OUTPUTS=
# 渲染失败最大重试次数
RENDER_MAX_ATTEMPTS=
# 编码质量（0 无损 ~ 51 最差）；23 均衡，20 更清晰
RENDER_CRF=
# x264 preset：ultrafast / veryfast / medium，越慢越小
RENDER_PRESET=
# 中文字体绝对路径。Debian 镜像内已装 fonts-noto-cjk，默认值见 Dockerfile
RENDER_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# 1 = 保留任务临时目录（排障用；生产留空，否则磁盘会涨）
RENDER_KEEP_TMP=
# 上传体积上限（字节），需与 Nginx client_max_body_size 对齐
MAX_UPLOAD_BYTES=536870912
# 全局背景音乐文件路径（可选）
BGM_FILE=

# ---------------------------------------------------------
# 四.5 本地配音与字幕（能力插件，全部离线，不接第三方）
# ---------------------------------------------------------
# 配音走操作系统自带的语音合成：Windows 用 System.Speech（如 Microsoft Huihui），
# macOS 用 say，Linux 用 espeak-ng。启动横幅与 /v1/edit/stats 会如实报告本机是否可用。
# 指定语音名（须与系统已安装语音完全一致，缺省会回落到第一个中文语音）
EDIT_TTS_VOICE=
# 默认语速（0.5~3.0），前端可按任务覆盖；用 ffmpeg atempo 变速、保持音调
EDIT_TTS_RATE=
# 1 = 显式禁用配音（成片输出无配音版本，界面如实标注）
EDIT_TTS_DISABLE=

# ---------------------------------------------------------
# 五、评论区采集（三真实通道 + 一模拟通道，可同时接入）
# ---------------------------------------------------------
# 系统支持两类截然不同的评论来源，任务是按「通道 + 范围」路由的：
#   自有内容评论区 → 只能走平台官方开放能力（合规最干净，半径=自有内容量）
#   第三方公开评论 → 只能走自建爬虫或第三方数据服务（半径大，责任自负）
#
# 通道优先级（任务 channel=auto 时）：
#   范围 own（自有内容）   → official → crawler → vendor
#   范围 keyword（搜公开） → vendor → crawler（official 读不到别人作品，不列入）
#   范围 auto（默认）      → vendor → crawler → official
# 任务可用 channel 字段写死某条通道；写死了但没接 → 直接失败，不降级。

# —— 通道 1：自有内容评论区（平台官方开放能力）——
# 只能读「自有账号发布的作品」下的评论。留空则该通道不可用
COLLECT_OFFICIAL_URL=
# 按官方网关要求填；网关内部完成签名时留空
COLLECT_OFFICIAL_TOKEN=
# 必填：自有账号标识（抖音 open_id / 视频号 finder id 等）。
# 缺这一项时采集不会报错，而是返回空 —— 别当成「没有评论」
COLLECT_OFFICIAL_OWNER=
COLLECT_OFFICIAL_TIMEOUT_MS=20000

# —— 通道 2：自建爬虫 ——
# 内网地址即可（如 http://crawler:8801），compose 里用 profiles=collectors 起
COLLECT_CRAWLER_URL=
# 仅在爬虫不在可信内网时才需要
COLLECT_CRAWLER_TOKEN=
# 爬虫带重试，超时默认放宽到 60s，避免把 30s 的巡检周期堵住
COLLECT_CRAWLER_TIMEOUT_MS=60000

# —— 通道 3：第三方数据服务（契约已冻结，保持兼容）——
# 留空时该通道不可用。注意：本通道的上游 body 只有
# { platform, keyword, limit, region }，不会带 scope 字段
COLLECT_UPSTREAM=
COLLECT_TOKEN=
COLLECT_TIMEOUT_MS=15000

# —— 全局默认通道 ——
# auto = 按上面那张优先级表自动选；也可写死 official / crawler / vendor
COLLECT_DEFAULT_CHANNEL=auto
# 定时调度的并发数与巡检周期（毫秒）
COLLECT_CONCURRENCY=2
COLLECT_TICK_MS=30000
# 1 = 不写入示例调度任务
COLLECT_NO_SEED=
# ⚠ 仅演示环境（DEMO_MODE=1）生效：一条真实通道都没接时用本地生成数据冒充采集结果
#   演示数据写入 .data/demo/，不进生产库；生产模式下此开关自动失效
ALLOW_LOCAL_COLLECT=

# ---------------------------------------------------------
# 六、GEO · AI 关键词监测
# ---------------------------------------------------------
# AI 检索收录监测服务地址。留空时监测任务返回 501 / 不发车
GEO_UPSTREAM=
GEO_TOKEN=
GEO_TIMEOUT_MS=20000
# 1 = 不写入示例监测任务
GEO_NO_SEED=
# ⚠ 仅演示环境（DEMO_MODE=1）生效：用确定性算法本地生成排名
#   生产模式下此开关自动失效，「AI 曝光率」必须来自 GEO_UPSTREAM
ALLOW_LOCAL_GEO=

# ---------------------------------------------------------
# 七、支付与订阅
# ---------------------------------------------------------
PAY_PROVIDER=
# 支付网关地址；PAY_GATEWAY + PAY_MCH_ID 同时存在才算「已配置」
PAY_GATEWAY=
PAY_MCH_ID=
# 回调验签密钥
PAY_NOTIFY_SECRET=
# 服务端写订阅记录所需的库密钥（客户端只读，唯一允许写 subscriptions 的地方）
SERVICE_DB_KEY=

# ---------------------------------------------------------
# 八、测试后门（生产必须留空）
# ---------------------------------------------------------
# 1 = 暴露 .build 静态目录 + 开启 /v1/qa/report，仅供自动化测试
QA_MODE=
