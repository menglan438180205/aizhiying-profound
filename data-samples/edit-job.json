    "ratio": "9:16 | 16:9 | 1:1",
    "shotSeconds": "number | 单镜头时长（秒）",
    "motion": "kenburns | none",
    "transition": "fade | none",
    "voice": "boolean | 是否生成配音",
    "voiceText": "string | 配音文案",
    "voiceRate": "number | 语速倍率",
    "subtitle": "boolean | 是否烧录字幕",
    "samples": "string[] | 内置示例素材 ID（免上传）",
    "assets": "string[] | 已上传素材 ID",
    "status": "queued | running | done | failed | canceled",
    "outputs": "{ url, bytes }[]"
  },
